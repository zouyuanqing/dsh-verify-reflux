{
  "name": "dsh-verify-reflux",
  "version": "0.1.0",
  "description": "Three-plane probabilistic verifier for DeepSeek Harness: session-model scoring with tiered logprob/sample/template judges, seeded tournament best-of-N, and layered context reflux.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./scale": {
      "types": "./lib/scale.d.ts",
      "default": "./lib/scale.js"
    },
    "./tournament": {
      "types": "./lib/tournament.d.ts",
      "default": "./lib/tournament.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "DESIGN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/",
    "check": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "llm-as-a-verifier",
    "verification",
    "probabilistic-scoring",
    "best-of-n",
    "reward-model",
    "agent-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zouyuanqing/dsh-verify-reflux.git"
  },
  "homepage": "https://github.com/zouyuanqing/dsh-verify-reflux#readme",
  "bugs": {
    "url": "https://github.com/zouyuanqing/dsh-verify-reflux/issues"
  }
}
